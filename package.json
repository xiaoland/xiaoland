{
  "name": "xiaoland",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "portless xiaoland vite",
    "dev:backend": "portless api.xiaoland wrangler dev --config wrangler.worker.toml",
    "build": "wrangler deploy --dry-run --outdir .worker-build --config wrangler.worker.toml",
    "deploy:worker:preview": "tsx scripts/deploy-preview-worker.ts",
    "typecheck": "tsc --noEmit",
    "verify:dist": "tsx src/ssg/verify-dist.ts",
    "check": "pnpm run typecheck && pnpm run verify:dist && pnpm run build:worker",
    "deploy": "pnpm run deploy:worker && pnpm run deploy:pages",
    "deploy:pages": "wrangler pages deploy dist --project-name xiaoland",
    "deploy:worker": "wrangler deploy --config wrangler.worker.toml",
    "ci": "pnpm run check && pnpm run build && pnpm run verify:dist"
  },
  "dependencies": {
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.8",
    "marked": "^17.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@hono/vite-dev-server": "^0.26.0",
    "@types/node": "^25.5.2",
    "@unocss/cli": "^66.5.12",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "wrangler": "^4.74.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}

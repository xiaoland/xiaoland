{
  "name": "xiaoland",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:uno\" \"pnpm run dev:ssg\" \"pnpm run dev:worker\"",
    "dev:ssg": "vite --mode ssg",
    "dev:worker": "wrangler dev --config wrangler.worker.toml --port 8787",
    "dev:uno": "watchexec --watch src --exts ts --restart -- unocss \"src/**/*.ts\" -c uno.config.ts -o \"./public/uno.css\"",
    "build": "pnpm run build:ssg && pnpm run build:worker",
    "build:ssg": "unocss \"src/**/*.ts\" -o \"./public/uno.css\" -c uno.config.ts && vite build --mode ssg && tsx src/ssg/postbuild.ts",
    "build:worker": "wrangler deploy --dry-run --outdir .worker-build --config wrangler.worker.toml",
    "deploy:worker:preview": "tsx scripts/deploy-preview-worker.ts",
    "preview:static": "vite preview --mode ssg --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "verify:dist": "tsx src/ssg/verify-dist.ts",
    "check": "pnpm run typecheck && pnpm run build:ssg && pnpm run verify:dist && pnpm run build:worker",
    "deploy": "pnpm run deploy:worker && pnpm run deploy:pages",
    "deploy:pages": "wrangler pages deploy dist --project-name xiaoland",
    "deploy:worker": "wrangler deploy --config wrangler.worker.toml"
  },
  "dependencies": {
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.8",
    "marked": "^17.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@hono/vite-dev-server": "^0.26.0",
    "@hono/vite-ssg": "^0.3.3",
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^25.5.2",
    "@unocss/cli": "^66.5.12",
    "@unocss/preset-icons": "^66.6.7",
    "@unocss/preset-wind3": "^66.6.7",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "unocss": "^66.5.12",
    "vite": "^8.0.0",
    "wrangler": "^4.74.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}

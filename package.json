{
	"name": "lanzhijiang-site",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"deploy": "pnpm run build && pnpm wrangler d1 migrations apply site --remote && wrangler deploy",
		"dev": "react-router dev",
		"postinstall": "pnpm run cf-typegen",
		"preview": "pnpm run build && vite preview",
		"typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b"
	},
	"dependencies": {
		"@cloudflare/d1": "^1.4.1",
		"drizzle-kit": "^0.31.5",
		"drizzle-orm": "^0.44.6",
		"isbot": "^5.1.31",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-router": "^7.9.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.13.5",
		"@mdx-js/mdx": "^3.1.1",
		"@mdx-js/rollup": "^3.1.1",
		"@react-router/dev": "^7.9.2",
		"@tailwindcss/vite": "^4.1.13",
		"@types/node": "^22",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"rehype-mdx-import-media": "^1.2.0",
		"remark-frontmatter": "^5.0.0",
		"remark-mdx-frontmatter": "^5.2.0",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vite-tsconfig-paths": "^5.1.4",
		"wrangler": "^4.43.0"
	}
}

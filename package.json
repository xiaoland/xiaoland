{
  "name": "xiaoland",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:uno\" \"vite\"",
    "dev:uno": "unocss \"src/**/*.ts\" -c uno.config.ts -o \"./public/uno.css\" --watch",
    "build": "unocss \"src/**/*.ts\" -c uno.config.ts && vite build",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.12.8",
    "marked": "^17.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@iconify-json/mdi": "^1.2.3",
    "@unocss/cli": "^66.5.12",
    "@unocss/preset-icons": "^66.6.7",
    "@unocss/preset-wind3": "^66.6.7",
    "concurrently": "^9.2.1",
    "typescript": "^5.8.3",
    "unocss": "^66.5.12",
    "vite": "^8.0.0",
    "wrangler": "^4.74.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
